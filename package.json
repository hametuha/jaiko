{
  "name": "jaiko",
  "version": "1.0.0",
  "description": "Jaiko WordPress theme build pipeline (Dart Sass + PostCSS + @kunoichi/grab-deps).",
  "homepage": "https://gianism.info",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hametuha/jaiko.git"
  },
  "bugs": {
    "url": "https://github.com/hametuha/jaiko/issues"
  },
  "author": "Hametuha INC.",
  "license": "GPL-2.0",
  "private": true,
  "scripts": {
    "copy:lib": "node ./bin/copy-lib.mjs",
    "build:css": "sass ./src/scss/:./assets/css/ --load-path=./node_modules/materialize-css/sass --style=compressed --no-source-map && postcss ./assets/css/*.css --use autoprefixer --replace --no-map",
    "build:js": "grab-deps js src/js assets/js",
    "dump": "grab-deps dump assets/js,assets/css",
    "package": "npm run build:css && npm run build:js && npm run copy:lib && npm run dump",
    "watch": "npm-watch"
  },
  "watch": {
    "build:css": {
      "extensions": "scss",
      "patterns": [
        "src/scss"
      ]
    },
    "build:js": {
      "extensions": "js",
      "patterns": [
        "src/js"
      ]
    },
    "dump": {
      "extensions": "js,css",
      "patterns": [
        "assets/js",
        "assets/css"
      ]
    }
  },
  "devDependencies": {
    "@kunoichi/grab-deps": "^3.1.4",
    "@wordpress/scripts": "^37.0.0",
    "autoprefixer": "^10.4.20",
    "jquery-match-height": "^0.7.2",
    "materialize-css": "0.97.8",
    "npm-watch": "^0.13.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "sass": "^1.83.0"
  }
}
